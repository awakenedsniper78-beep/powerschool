# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored; this template is safe to commit because it has no secrets.

PS_BASE_URL=https://birmingham.powerschool.com
PS_USERNAME=
PS_PASSWORD=

# Fallback only — leave blank unless scripted login gets blocked by bot protection.
# If needed: log in with your browser, open DevTools > Application > Cookies,
# and copy the value of the JSESSIONID cookie here.
PS_COOKIE=
